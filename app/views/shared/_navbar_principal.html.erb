<header class="vian-header">
  <div class="container d-flex align-items-center justify-content-between py-3 gap-3">
    <%= link_to root_path, class: "vian-brand", aria: { label: "Vian Propiedades · Inicio" } do %>
      <%= image_tag "logo_vian_transparente_letras_blancas.png", alt: "Vian Propiedades", width: 150 %>
    <% end %>
    <nav class="vian-desktop-nav" aria-label="Navegación principal">
      <%= render "shared/navigation_links" %>
    </nav>
    <details class="vian-mobile-nav">
      <summary>Menú</summary>
      <nav aria-label="Navegación móvil">
        <%= render "shared/navigation_links" %>
      </nav>
    </details>
  </div>
</header>
