<section class="site-blocks-cover overlay vian-hero" data-controller="hero-carousel">
  <div class="vian-hero-backgrounds">
    <% @propiedades_hero.each_with_index do |propiedad, index| %>
      <%= link_to propiedad_path(propiedad),
        class: "vian-hero-slide #{'is-active' if index.zero?}",
        aria: { label: "Ver propiedad: #{propiedad.titulo}", hidden: !index.zero? },
        tabindex: (index.zero? ? 0 : -1),
        data: { hero_carousel_target: "slide" } do %>
        <%= image_tag imagen_propiedad(propiedad), alt: "", class: "vian-hero-image" %>
      <% end %>
    <% end %>

    <% if @propiedades_hero.empty? %>
      <%= image_tag "hero_bg_1.jpg", alt: "", class: "vian-hero-slide is-active" %>
    <% end %>
  </div>

  <div class="container">
    <div class="row align-items-center justify-content-center text-center">
      <div class="col-lg-9">
        <%= image_tag "logo_vian_transparente_letras_blancas.png", alt: "Vian Propiedades", class: "vian-hero-logo" %>
        <h1 class="mb-5 fw-semibold">Un nuevo lugar para vivir</h1>
        <p class="mb-5 text-white fw-semibold">Explora nuestras propiedades y encuentra el espacio que estás buscando.</p>
        <%= link_to "Ver propiedades", propiedades_path, class: "btn vian-public-button btn-white btn-outline-white py-3 px-5 rounded-0" %>
      </div>
    </div>
  </div>
  <% if @propiedades_hero.size > 1 %>
    <div class="vian-hero-controls" role="group" aria-label="Controles del carrusel de propiedades">
      <button type="button" class="vian-hero-arrow" data-action="hero-carousel#previous" aria-label="Imagen anterior">
        <span aria-hidden="true">&#10094;</span>
      </button>

      <div class="vian-hero-indicators">
        <% @propiedades_hero.each_with_index do |propiedad, index| %>
          <button
            type="button"
            class="vian-hero-indicator <%= 'is-active' if index.zero? %>"
            data-hero-carousel-target="indicator"
            data-action="hero-carousel#select"
            data-hero-carousel-index-param="<%= index %>"
            aria-label="Ver imagen de <%= propiedad.titulo %>"
            aria-current="<%= index.zero? %>">
          </button>
        <% end %>
      </div>

      <button type="button" class="vian-hero-arrow" data-action="hero-carousel#next" aria-label="Imagen siguiente">
        <span aria-hidden="true">&#10095;</span>
      </button>
    </div>
  <% end %>
</section>
