<footer class="site-footer">
  <div class="container">
    <div class="row g-4">
      <div class="col-md-7">
        <h2 class="footer-heading mb-4">Vian Propiedades</h2>
        <p>Encuentra tu próximo hogar. Explora nuestras propiedades y descubre sus espacios, ubicación y características.</p>
        <%= render "shared/social_links", location: "footer" %>
      </div>
      <div class="col-md-4 offset-md-1">
        <h2 class="footer-heading mb-4">Explora</h2>
        <ul class="list-unstyled">
          <li>
            <%= link_to "Inicio", root_path %>
          </li>
          <li>
            <%= link_to "Todas las propiedades", propiedades_path %>
          </li>
          <li>
            <%= link_to new_user_session_path, class: "vian-footer-private-access" do %>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <circle cx="12" cy="8" r="4" />
                <path d="M4.5 21a7.5 7.5 0 0 1 15 0" />
              </svg>
              <span>Área privada</span>
            <% end %>
          </li>
        </ul>
      </div>
    </div>
    <p class="mt-5 mb-0 text-center">
      <strong class="d-block">© <%= Date.current.year %> Vian Propiedades</strong>
      <span class="vian-footer-development d-block">
        <span class="vian-footer-development-line">
          <span>¿Te gustó este sitio? Desarrollado por</span>
          <%= link_to "https://vosolutions.cl", target: "_blank", rel: "noopener", class: "vian-footer-development-link", aria: { label: "Visitar VOSolutions" } do %>
            <%= image_tag "VO_Solutions_blanco-removebg-preview-sm.png", alt: "VOSolutions", class: "vian-footer-development-logo" %>
          <% end %>
        </span>
        <span class="vian-footer-contact-line">
          <span>O contáctanos a nuestro mail</span>
          <%= mail_to "cesar.osses@gmail.com", class: "vian-footer-development-email", aria: { label: "Escribir a cesar.osses@gmail.com" }, title: "Contactar a VOSolutions" do %>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M3 5.5h18v13H3z" />
              <path d="m3.5 6 8.5 7 8.5-7" />
            </svg>
            <span>contacto@vosolutions.cl</span>
          <% end %>
        </span>
      </span>
      <small class="vian-footer-credit">Basado en Homeland de Colorlib</small>
    </p>
  </div>
</footer>
