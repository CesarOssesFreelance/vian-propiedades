<% content_for :title, "Nueva propiedad | Vian Propiedades" %>

<section class="site-section bg-light" aria-labelledby="property-form-title">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-10">
        <div class="text-center mb-4">
          <h1 id="property-form-title" class="h2 text-black">Nueva propiedad</h1>
          <p class="mb-0">Completa los datos de la propiedad.</p>
        </div>
        <%= render "form", propiedad: @propiedad %>
        <p class="text-center mt-4 mb-0">
          <%= link_to "Volver a propiedades", propiedades_path %>
        </p>
      </div>
    </div>
  </div>
</section>
