    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
  </button>
  <button type="button" class="vian-gallery-arrow vian-gallery-arrow-next" data-action="property-gallery#next" aria-label="Fotografía siguiente">
