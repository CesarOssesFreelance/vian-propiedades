<% photos = [] %>
<% photos << propiedad.imagen_principal if propiedad.imagen_principal.attached? %>
<% photos.concat(propiedad.imagenes.to_a) %>
<% if photos.empty? %>
  <%= image_tag imagen_propiedad(propiedad), alt: propiedad.titulo, class: "vian-detail-image" %>
  <p class="small mt-2">Imagen referencial. Esta propiedad aún no tiene fotografías publicadas.</p>
<% else %>
  <div data-controller="property-gallery" data-action="turbo:before-cache@document->property-gallery#cleanup" class="vian-gallery">
    <div class="vian-gallery-stage" aria-label="Fotografías de la propiedad">
      <% photos.each_with_index do |photo, index| %>
        <button type="button" class="vian-gallery-slide" data-property-gallery-target="slide" data-action="property-gallery#open" <%= "hidden" unless index.zero? %> aria-label="Ampliar fotografía <%= index + 1 %>">
          <%= image_tag photo.variant(:gallery),
            alt: "#{propiedad.titulo} · Fotografía #{index + 1}",
            class: "vian-detail-image",
            loading: index.zero? ? "eager" : "lazy",
            fetchpriority: index.zero? ? "high" : "low",
            decoding: "async" %>
        </button>
      <% end %>
      <%= render "propiedades/gallery_arrows", photos: photos %>
    </div>
    <%= render "propiedades/gallery_thumbnails", photos: photos %>
    <dialog class="vian-gallery-modal" data-property-gallery-target="dialog" data-action="close->property-gallery#closed keydown->property-gallery#keydown">
      <div class="vian-gallery-modal-header">
        <h2 class="h5 mb-0">Fotografías de <%= propiedad.titulo %></h2>
        <button type="button" data-action="property-gallery#close" aria-label="Cerrar galería" autofocus>✕</button>
      </div>
      <div class="vian-gallery-stage" aria-label="Fotografías ampliadas de la propiedad">
        <img data-property-gallery-target="enlarged" class="vian-gallery-enlarged" alt="">
        <%= render "propiedades/gallery_arrows", photos: photos %>
      </div>
      <%= render "propiedades/gallery_thumbnails", photos: photos %>
    </dialog>
  </div>
<% end %>
