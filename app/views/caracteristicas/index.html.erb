<% content_for :title, "Características | Vian Propiedades" %>

<section class="vian-page-heading">
  <div class="container">
    <p>Administra los atributos de tus propiedades</p>
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center">
      <h1 class="mb-0">Características</h1>
      <%= link_to "Nueva característica", new_caracteristica_path, class: "btn btn-success rounded-0 mt-3 mt-md-0 align-self-start align-self-md-center" %>
    </div>
  </div>
</section>

<section class="site-section site-section-sm bg-light">
  <div class="container">
    <p class="mb-4"><%= @caracteristicas.size %> características registradas</p>

    <% if @caracteristicas.any? %>
      <div class="bg-white border p-3 p-md-4">
        <div class="table-responsive">
          <table class="table table-hover mb-0 vian-characteristics-table">
            <caption class="sr-only">Características disponibles para las propiedades</caption>
            <thead>
              <tr>
                <th scope="col">ID</th>
                <th scope="col">Nombre</th>
                <th scope="col">Clave</th>
                <th scope="col" class="text-right">Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% @caracteristicas.each do |caracteristica| %>
                <tr>
                  <td><%= caracteristica.id %></td>
                  <th scope="row" class="font-weight-normal text-black"><%= caracteristica.nombre %></th>
                  <td><span class="text-muted"><%= caracteristica.clave %></span></td>
                  <td>
                    <div class="d-flex justify-content-end vian-characteristic-actions">
                      <%= link_to "Editar", edit_caracteristica_path(caracteristica), class: "btn btn-sm btn-outline-primary rounded-0" %>
                      <% if current_user.admin? %>
                        <%= button_to "Eliminar", caracteristica, method: :delete,
                            data: { turbo_confirm: "¿Estás seguro de eliminar esta característica?" },
                            class: "btn btn-sm btn-outline-danger rounded-0" %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% else %>
      <div class="bg-white border p-4 p-md-5 text-center">
        <h2 class="h4 text-black">Aún no hay características</h2>
        <p class="mb-0">Agrega la primera con el botón «Nueva característica».</p>
      </div>
    <% end %>
  </div>
</section>
