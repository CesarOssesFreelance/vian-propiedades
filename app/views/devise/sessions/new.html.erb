<% content_for :title, "Iniciar sesión | Vian Propiedades" %>
<section class="vian-auth bg-light" aria-labelledby="auth-title">
  <div class="vian-auth-card bg-white border p-4 p-md-5">
    <h1 id="auth-title" class="h2 text-center text-black mb-4">Iniciar sesión</h1>
    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="form-group">
        <%= f.label :email, "Correo electrónico", class: "text-black" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "form-control" %>
      </div>
      <div class="form-group">
        <%= f.label :password, "Contraseña", class: "text-black" %>
        <%= f.password_field :password, autocomplete: "current-password", required: true, class: "form-control" %>
      </div>
      <% if devise_mapping.rememberable? %>
        <div class="form-group form-check">
          <%= f.check_box :remember_me, class: "form-check-input" %>
          <%= f.label :remember_me, "Recordarme", class: "form-check-label" %>
        </div>
      <% end %>
      <%= f.submit "Iniciar sesión", class: "btn vian-auth-button py-2 px-4 rounded-0 w-100" %>
    <% end %>
    <div class="text-center mt-4">
      <p class="mb-2"><%= link_to "Crear una cuenta", new_registration_path(resource_name) %></p>
      <%= link_to "¿Olvidaste tu contraseña?", new_password_path(resource_name) %>
    </div>
  </div>
</section>
