<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Vian Propiedades" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Vian Propiedades">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= render 'shared/navbar_principal' %>
    <% if flash[:notice] %>
      <div class=" alert alert-success my-0">
        <%= flash[:notice] %>
      </div>
    <% end %>
    <div class="site-loader"></div>
    <div class="site-wrap">
    <main>
      <%= yield %>
    </main>
    </div>






    <%= javascript_include_tag "bootstrap.bundle.min", defer: true %>
    <%= javascript_include_tag "vendor/jquery-3.3.1.min" %>
    <%= javascript_include_tag "vendor/jquery-migrate-3.0.1.min" %>
    <%= javascript_include_tag "vendor/jquery-ui" %>

    <%= javascript_include_tag "vendor/popper.min" %>

    <%= javascript_include_tag "vendor/jquery.stellar.min" %>
    <%= javascript_include_tag "vendor/owl.carousel.min" %>
    <%= javascript_include_tag "vendor/slick.min" %>

    <%= javascript_include_tag "vendor/jquery.magnific-popup.min" %>
    <%= javascript_include_tag "vendor/jquery.countdown.min" %>
    <%= javascript_include_tag "vendor/bootstrap-datepicker.min" %>

    <%= javascript_include_tag "vendor/aos" %>
    <%= javascript_include_tag "vendor/circleaudioplayer" %>
    <%= javascript_include_tag "vendor/mediaelement-and-player.min" %>
    <%= javascript_include_tag "vendor/player" %>

    <%= javascript_include_tag "vendor/main" %>
  </body>
</html>
