<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Vian Propiedades" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag "bootstrap.min", "style", "main", "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <div class="site-wrap">
      <%= render "shared/navbar_principal" %>
      <%= render "shared/flash_messages" %>
      <main id="contenido">
        <%= yield %>
      </main>
      <%= render "shared/footer" %>
    </div>
    <%= render "shared/whatsapp_button" %>
    <button type="button"
      class="vian-back-to-top"
      data-controller="back-to-top"
      data-action="scroll@window->back-to-top#update:passive pageshow@window->back-to-top#update click->back-to-top#scrollToTop"
      aria-label="Volver arriba"
      title="Volver arriba"
      hidden>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M12 19V5M5 12l7-7 7 7" />
      </svg>
    </button>
  </body>
</html>
